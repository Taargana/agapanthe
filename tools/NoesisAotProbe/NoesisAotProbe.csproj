<Project Sdk="Microsoft.NET.Sdk">

  <!-- Noesis spike (branch spike/noesis-probe): isolated feasibility probe, same discipline as
       tools/CefAotProbe. Does NOT reference Agapanthe.Engine/World — pure native-interop question. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Noesis.GUI" Version="4.0.0" />
    <PackageReference Include="Noesis.App" Version="4.0.0" />
    <PackageReference Include="Noesis.App.Displays.Win32" Version="4.0.0" />
    <PackageReference Include="Noesis.App.RenderContexts.WGL" Version="4.0.0" />
  </ItemGroup>

</Project>
