<Project Sdk="Microsoft.NET.Sdk">

  <!-- THE SIMULATION. Since MP-0a this project references neither Rendering nor Graphics: the whole point is that a
       dedicated server can run it with no Vulkan on the machine, which is what makes topology a DEPLOYMENT choice
       rather than an architecture one (backlog §4quater). The render half — RenderContext, IRenderSystem,
       FrameOrchestrator, the UI and overlay systems — lives in Agapanthe.Engine.Render.

       DO NOT ADD Agapanthe.Rendering, Agapanthe.Graphics, Agapanthe.Platform OR ANY Silk.NET PACKAGE HERE.
       Two tests enforce it (EngineIsHeadlessTests): one asserts this file's ProjectReference set is exactly
       {Core, World} — which bites at the commit that adds the reference, before any type is used and while the
       compiler would still elide it from the manifest — and one walks the built assembly's reference closure.

       Platform was already excluded before the split, for the same reason: dragging GLFW in would kill the
       "simulation runs headless" argument. The Input stage is therefore empty on the engine side — the application
       fills it. -->
  <ItemGroup>
    <ProjectReference Include="..\Agapanthe.Core\Agapanthe.Core.csproj" />
    <ProjectReference Include="..\Agapanthe.World\Agapanthe.World.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Phase 2 rule 1: trim/AOT analyzers at build time (permanent gate). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Agapanthe.Tests" />
  </ItemGroup>

</Project>
