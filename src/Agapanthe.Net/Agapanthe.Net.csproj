<Project Sdk="Microsoft.NET.Sdk">

  <!-- Net-1: the network transport + wire codec, in the SAME headless closure as Agapanthe.Engine —
       {Core, Engine} exactly (not World: nothing here names a World/Arch type — an audit finding caught the
       ProjectReference as a dead one, present only because World arrives transitively via Engine anyway), no
       GPU/window types. A dedicated server (samples/DedicatedServer) links this alongside Agapanthe.Engine and
       Agapanthe.World directly, with no GPU on the machine; a thin client (samples/ThinClient) links it
       alongside the full render stack. EngineIsHeadlessTests' static allowlist AND its reflective closure walk
       (rooted here too, not only on Agapanthe.Engine) guard this project the same way every structural project
       has been guarded since MP-0a. -->
  <ItemGroup>
    <ProjectReference Include="..\Agapanthe.Core\Agapanthe.Core.csproj" />
    <ProjectReference Include="..\Agapanthe.Engine\Agapanthe.Engine.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Phase 2 rule 1: trim/AOT analyzers at build time. Verified this session: LiteNetLib 2.1.4 itself
         publishes NativeAOT-clean with 0 trim/AOT analyzer warnings. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reliable UDP (Net-1 D3) — not hand-rolled: sequence numbers/ack windows/retransmission/wraparound
         correctly is a sub-project of its own, orthogonal to the engine's domain. -->
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Agapanthe.Tests" />
  </ItemGroup>

</Project>
