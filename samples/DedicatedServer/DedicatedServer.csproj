<Project Sdk="Microsoft.NET.Sdk">

  <!-- Net-1: the dedicated server. Same composition-root pattern as HeadlessSim (GameWorld + SimulationHost +
       PhysicsSystem, no window, no Vulkan device, no Silk.NET) — but loops on network activity instead of a
       fixed tick count, replicating dirty drawables to a single connected client instead of writing a snapshot
       to disk. No cooked content needed server-side: it never resolves an AssetKey to a GPU handle, it only
       names one over the wire. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Agapanthe.Core\Agapanthe.Core.csproj" />
    <ProjectReference Include="..\..\src\Agapanthe.World\Agapanthe.World.csproj" />
    <ProjectReference Include="..\..\src\Agapanthe.Engine\Agapanthe.Engine.csproj" />
    <ProjectReference Include="..\..\src\Agapanthe.Net\Agapanthe.Net.csproj" />
  </ItemGroup>

</Project>
